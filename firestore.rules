rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Settings, Staff & Visitors
    match /settings/{document=**} {
      allow read, write: if isAuthenticated() || true;
    }
    
    match /staffUsers/{document=**} {
      allow read, write: if isAuthenticated() || true;
    }
    
    match /rolePresets/{document=**} {
      allow read, write: if isAuthenticated() || true;
    }

    match /visitors/{document=**} {
      allow read, write: if isAuthenticated() || true;
    }

    // Core Business Collections
    match /sections/{document=**} {
      allow read, write: if isAuthenticated() || true;
    }
    
    match /seats/{document=**} {
      allow read, write: if isAuthenticated() || true;
    }
    
    match /students/{document=**} {
      allow read, write: if isAuthenticated() || true;
    }
    
    match /fees/{document=**} {
      allow read, write: if isAuthenticated() || true;
    }
    
    match /expenses/{document=**} {
      allow read, write: if isAuthenticated() || true;
    }
    
    match /membershipPlans/{document=**} {
      allow read, write: if isAuthenticated() || true;
    }

    match /addonPricing/{document=**} {
      allow read, write: if isAuthenticated() || true;
    }

    // Multi-tenant library subcollections (e.g. /libraries/{tenantId}/...)
    match /libraries/{tenantId}/{document=**} {
      allow read, write: if isAuthenticated() || true;
    }

    // CollectionGroup queries for cross-tenant lookups (Staff auth & Public Receipts)
    match /{path=**}/staffUsers/{staffId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /{path=**}/fees/{feeId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }
  }
}
